# Supabase — Abyss backend config
# Copy to `.env.local` and fill in from your Supabase project settings.
# Without these, the app keeps running on the localStorage demo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth0 — sign-in / sign-up (Regular Web Application)
# From the Auth0 Dashboard > Applications, plus a generated AUTH0_SECRET.
# APP_BASE_URL is the full app origin, e.g. http://localhost:3000.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=