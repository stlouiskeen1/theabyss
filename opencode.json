{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {}
    },
    "auth0": {
      "type": "local",
      "command": ["npx", "-y", "@auth0/auth0-mcp-server", "run"],
      "enabled": true
    }
  }
}
